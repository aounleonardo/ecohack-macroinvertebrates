# Local full stack (backend on :8000): leave VITE_API_URL UNSET — Vite proxies /api → 127.0.0.1:8000
# Production Netlify only:
# VITE_API_URL=https://your-service.onrender.com

# If Lightning exposes CORS + safe browser auth, call inference directly:
# VITE_LIGHTNING_INFER_URL=https://your-lightning-endpoint/infer

# Optional: prefill demo login in dev only (do not commit real secrets)
# VITE_DEMO_PASSWORD=river2026
# Optional: call a GPU endpoint straight from the browser (must allow CORS). Otherwise uploads go to {VITE_API_URL}/api/inference.
# VITE_INFER_URL=
