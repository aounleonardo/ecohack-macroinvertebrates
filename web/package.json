{
  "name": "macroinvertebrates-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "etl": "python3 ../scripts/etl_kieco.py && python3 ../scripts/etl_taxa.py && python3 ../scripts/etl_site_series.py",
    "etl:rivers": "python3 ../scripts/build_river_reaches.py",
    "etl:full": "npm run etl && npm run etl:rivers",
    "fetch-thumbs": "python3 ../scripts/etl_taxa.py && python3 ../scripts/fetch_family_thumbs.py",
    "prebuild": "npm run etl",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "maplibre-gl": "^4.7.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.2",
    "vite": "^6.0.0"
  }
}
